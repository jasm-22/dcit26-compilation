import React from 'react';
import { View, Text, Image, ScrollView, StyleSheet } from 'react-native';
import { Feather } from '@expo/vector-icons';

export default function Profile({ route }) {
  const { user } = route.params;

  const address = `${user.location.street.number} ${user.location.street.name}, ${user.location.city}, ${user.location.state}, ${user.location.country}`;

  // One row: line icon in a light box + label + value
  const Row = ({ icon, label, value }) => (
    <View style={styles.row}>
      <View style={styles.iconBox}>
        <Feather name={icon} size={18} color="#3B2A96" />
      </View>
      <View style={styles.rowText}>
        <Text style={styles.rowLabel}>{label}</Text>
        <Text style={styles.rowValue}>{value}</Text>
      </View>
    </View>
  );

  return (
    <ScrollView style={styles.container} contentContainerStyle={styles.content}>
      {/* Purple container: starts at the picture, ends after the last detail */}
      <View style={styles.purple}>
        <Image source={{ uri: user.picture.large }} style={styles.image} />
        <Text style={styles.name}>
          {user.name.title} {user.name.first} {user.name.last}
        </Text>
        <Text style={styles.subtitle}>{user.location.country}</Text>

        {/* White details card inside the purple */}
        <View style={styles.card}>
          <Text style={styles.sectionTitle}>About</Text>
          <Row icon="gift" label="Age" value={user.dob.age} />
          <Row icon="calendar" label="Birthday" value={user.dob.date} />
          <Row icon="user" label="Gender" value={user.gender} />
          <Row icon="map-pin" label="Address" value={address} />

          <Text style={styles.sectionTitle}>Contact</Text>
          <Row icon="mail" label="Email" value={user.email} />
          <Row icon="phone" label="Phone" value={user.phone} />

          <Text style={styles.sectionTitle}>Other</Text>
          <Row
            icon="clock"
            label="Date registered"
            value={user.registered.date}
          />
        </View>
      </View>
    </ScrollView>
  );
}

